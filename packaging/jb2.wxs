<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- UpgradeCode is permanent. Do not change it between releases. -->
  <Package
    Name="JB2"
    Manufacturer="Mikael"
    Version="$(var.Version)"
    UpgradeCode="a7e4c91b-3f62-4a18-9d8e-b15c6a0f3e27"
    Scope="perUser"
    Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of JB2 is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="webroot\img\jukeboks.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="JB2" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="App" Title="JB2" Description="JB2 application files" Level="1" AllowAbsent="no" Display="expand">
      <Files Directory="INSTALLFOLDER" Include="!(bindpath.payload)\jb2.exe" />
      <Files Directory="INSTALLFOLDER" Subdirectory="webroot" Include="!(bindpath.payload)\webroot\**" />
    </Feature>

    <Feature Id="StartMenuShortcut" Title="Start Menu shortcut" Description="Add JB2 to the Start Menu" Level="1" AllowAbsent="yes" AllowAdvertise="no">
      <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="*">
        <Shortcut
          Id="AppShortcut"
          Name="JB2"
          Description="JB2"
          Target="[INSTALLFOLDER]jb2.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="AppIcon"
          Advertise="no" />
        <RegistryValue Root="HKCU" Key="Software\Mikael\JB2" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>

    <ui:WixUI Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="packaging\license.rtf" />
  </Package>
</Wix>
